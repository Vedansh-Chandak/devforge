{
  "name": "@devforge/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "devforge": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devforge/brain": "workspace:*",
    "@devforge/config": "workspace:*",
    "@devforge/execution": "workspace:*",
    "@devforge/knowledge-graph": "workspace:*",
    "@devforge/model-provider": "workspace:*",
    "@devforge/parser-typescript": "workspace:*",
    "@devforge/planner": "workspace:*",
    "@devforge/repository-indexer": "workspace:*",
    "@devforge/runtime": "workspace:*",
    "@devforge/symbol-graph": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "typescript": "5.9.2",
    "vitest": "^2.0.0"
  }
}